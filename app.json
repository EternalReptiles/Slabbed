{
  "expo": {
    "name": "Holo Binder",
    "slug": "holo-binder",
    "scheme": "holobinder",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Holo Binder uses the camera to photograph your cards so it can identify, value and grade them.",
          "photosPermission": "Holo Binder lets you pick photos of your cards to identify, value and grade them."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.eternalreptiles.holobinder"
    },
    "android": {
      "package": "com.eternalreptiles.holobinder"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Holo Binder",
      "shortName": "Holo Binder",
      "themeColor": "#2F55E4",
      "backgroundColor": "#EEF1F6"
    },
    "experiments": {
      "baseUrl": "/pokemon",
      "typedRoutes": false
    }
  }
}
